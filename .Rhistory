# Load all functions from the local DIVE package
devtools::load_all()
# Load ecosystem-functionality data
removal_data <- readxl::read_excel(
"data/Removal_Efficiency.xlsx"
)
# Inspect available columns
print(
colnames(removal_data)
)
# Use BOD removal as ecosystem functionality
functionality <- removal_data$BOD_removal
cat(
"Number of functionality observations:",
length(functionality),
"\n"
)
cat(
"Number of TSE samples:",
ncol(tse_function),
"\n"
)
if (
length(functionality) != ncol(tse_function)
) {
stop(
"The functionality vector and TSE contain different ",
"numbers of observations."
)
}
# Check that Date exists in colData
if (
!"Date" %in%
colnames(
SummarizedExperiment::colData(
tse_function
)
)
) {
stop(
"tse_function does not contain `Date` in colData."
)
}
# Check Date class
if (
!inherits(
SummarizedExperiment::colData(
tse_function
)$Date,
"Date"
)
) {
stop(
"`colData(tse_function)$Date` must have class Date."
)
}
# Display dates and functionality together
input_check <- data.frame(
Date =
SummarizedExperiment::colData(
tse_function
)$Date,
BOD_removal =
functionality
)
print(
input_check
)
result <- dive(
tse = tse_function,
