plot_data <- data.frame(
Date = sample_dates,
`Richness (Observed)` =
alpha_data$observed,
`Diversity (Shannon)` =
alpha_data$shannon,
`Rarity (ACE)` =
alpha_data$ace,
`Dominance (Simpson lambda)` =
alpha_data$simpson_lambda,
`Evenness (Pielou)` =
alpha_data$pielou,
BOD_removal = BOD_removal,
check.names = FALSE
)
# Sort everything chronologically
plot_data <- plot_data[
order(
plot_data$Date
),
,
drop = FALSE
]
alpha_long <- plot_data %>%
tidyr::pivot_longer(
cols = c(
`Richness (Observed)`,
`Diversity (Shannon)`,
`Rarity (ACE)`,
`Dominance (Simpson lambda)`,
`Evenness (Pielou)`
),
names_to = "Metric",
values_to = "Alpha_value"
)
alpha_long <- alpha_long %>%
dplyr::group_by(
Metric
) %>%
dplyr::mutate(
Alpha_z = as.numeric(
scale(
Alpha_value
)
)
) %>%
dplyr::ungroup()
alpha_min <- min(
alpha_long$Alpha_z,
na.rm = TRUE
)
alpha_max <- max(
alpha_long$Alpha_z,
na.rm = TRUE
)
bod_min <- min(
plot_data$BOD_removal,
na.rm = TRUE
)
bod_max <- max(
plot_data$BOD_removal,
na.rm = TRUE
)
if (bod_max == bod_min) {
stop(
"BOD removal has zero variance."
)
}
bod_to_alpha <- function(x) {
(
(x - bod_min) /
(bod_max - bod_min)
) *
(
alpha_max - alpha_min
) +
alpha_min
}
alpha_to_bod <- function(x) {
(
(x - alpha_min) /
(alpha_max - alpha_min)
) *
(
bod_max - bod_min
) +
bod_min
}
plot_data$BOD_scaled <- bod_to_alpha(
plot_data$BOD_removal
)
alpha_long$Metric <- factor(
alpha_long$Metric,
levels = c(
"Richness (Observed)",
"Diversity (Shannon)",
"Rarity (ACE)",
"Dominance (Simpson lambda)",
"Evenness (Pielou)"
)
)
metric_colors <- c(
"Richness (Observed)" = "#0072B2",
"Diversity (Shannon)" = "#009E73",
"Rarity (ACE)" = "#D55E00",
"Dominance (Simpson lambda)" = "#CC79A7",
"Evenness (Pielou)" = "#E69F00",
"BOD removal" = "#000000"
)
p <- ggplot() +
geom_hline(
yintercept = 0,
linetype = "dotted",
linewidth = 0.35,
color = "grey50"
) +
geom_line(
data = alpha_long,
aes(
x = Date,
y = Alpha_z,
color = Metric,
group = Metric
),
linewidth = 0.9,
na.rm = TRUE
) +
geom_point(
data = alpha_long,
aes(
x = Date,
y = Alpha_z,
color = Metric
),
size = 2,
na.rm = TRUE
) +
geom_line(
data = plot_data,
aes(
x = Date,
y = BOD_scaled,
color = "BOD removal"
),
linewidth = 1.2,
linetype = "dashed",
na.rm = TRUE
) +
geom_point(
data = plot_data,
aes(
x = Date,
y = BOD_scaled,
color = "BOD removal"
),
size = 2.5,
shape = 18,
na.rm = TRUE
) +
scale_color_manual(
values = metric_colors,
breaks = c(
"Richness (Observed)",
"Diversity (Shannon)",
"Rarity (ACE)",
"Dominance (Simpson lambda)",
"Evenness (Pielou)",
"BOD removal"
),
name = NULL
) +
scale_y_continuous(
name = "Alpha diversity (standardized z-score)",
sec.axis = sec_axis(
trans = ~ alpha_to_bod(.),
name = "BOD removal"
)
) +
scale_x_date(
date_breaks = "4 months",
date_labels = "%b\n%Y",
expand = expansion(
mult = c(
0.01,
0.02
)
)
) +
labs(
x = "Sampling date"
) +
theme_classic(
base_size = 12
) +
theme(
plot.title = element_blank(),
axis.title.x = element_text(
size = 12,
margin = margin(
t = 10
)
),
axis.text.x = element_text(
size = 9
),
axis.title.y.left = element_text(
size = 12,
margin = margin(
r = 10
)
),
axis.text.y.left = element_text(
size = 10
),
axis.title.y.right = element_text(
size = 12,
margin = margin(
l = 10
)
),
axis.text.y.right = element_text(
size = 10
),
legend.position = "bottom",
legend.direction = "horizontal",
legend.box = "horizontal",
legend.text = element_text(
size = 10
),
legend.key.width = grid::unit(
1.4,
"cm"
),
plot.margin = margin(
10,
15,
10,
10
)
)
print(
p
)
ggplot2::ggsave(
filename = "DIVE_alpha_diversity_BOD_combined_time_series.png",
plot = p,
width = 12,
height = 7,
units = "in",
dpi = 600,
bg = "white"
)
alpha_data <- as.data.frame(
SummarizedExperiment::colData(
tse_alpha
)
)
missing_metrics <- setdiff(
alpha_metrics,
colnames(
alpha_data
)
)
if (length(
missing_metrics
) > 0L) {
stop(
"The following alpha-diversity metrics were not returned: ",
paste(
missing_metrics,
collapse = ", "
)
)
}
alpha_data <- alpha_data[
,
alpha_metrics,
drop = FALSE
]
for (metric_name in alpha_metrics) {
alpha_data[[metric_name]] <- as.numeric(
alpha_data[[metric_name]]
)
}
plot_data <- data.frame(
Date = sample_dates,
`Richness (Observed)` =
alpha_data$observed,
`Diversity (Shannon)` =
alpha_data$shannon,
`Rarity (ACE)` =
alpha_data$ace,
`Dominance (Simpson lambda)` =
alpha_data$simpson_lambda,
`Evenness (Pielou)` =
alpha_data$pielou,
`BOD removal` =
BOD_removal,
check.names = FALSE
)
plot_data <- plot_data[
order(
plot_data$Date
),
,
drop = FALSE
]
plot_long <- plot_data %>%
tidyr::pivot_longer(
cols = c(
`Richness (Observed)`,
`Diversity (Shannon)`,
`Rarity (ACE)`,
`Dominance (Simpson lambda)`,
`Evenness (Pielou)`,
`BOD removal`
),
names_to = "Metric",
values_to = "Value"
)
plot_long$Metric <- factor(
plot_long$Metric,
levels = c(
"Richness (Observed)",
"Diversity (Shannon)",
"Rarity (ACE)",
"Dominance (Simpson lambda)",
"Evenness (Pielou)",
"BOD removal"
)
)
metric_colors <- c(
"Richness (Observed)" = "#0072B2",
"Diversity (Shannon)" = "#009E73",
"Rarity (ACE)" = "#D55E00",
"Dominance (Simpson lambda)" = "#CC79A7",
"Evenness (Pielou)" = "#E69F00",
"BOD removal" = "#000000"
)
p <- ggplot(
plot_long,
aes(
x = Date,
y = Value,
color = Metric,
group = Metric
)
) +
geom_line(
linewidth = 0.9,
na.rm = TRUE
) +
geom_point(
size = 2.2,
na.rm = TRUE
) +
facet_wrap(
~ Metric,
ncol = 2,
scales = "free_y"
) +
scale_color_manual(
values = metric_colors,
guide = "none"
) +
scale_x_date(
date_breaks = "6 months",
date_labels = "%b\n%Y",
expand = expansion(
mult = c(
0.01,
0.02
)
)
) +
labs(
x = "Sampling date",
y = NULL
) +
theme_classic(
base_size = 12
) +
theme(
# No overall title
plot.title = element_blank(),
# Panel labels
strip.background = element_blank(),
strip.text = element_text(
face = "bold",
size = 11
),
# X axis
axis.text.x = element_text(
size = 8.5
),
axis.title.x = element_text(
size = 12,
margin = margin(
t = 10
)
),
# Y axis
axis.text.y = element_text(
size = 9
),
# Spacing between panels
panel.spacing = grid::unit(
1.1,
"lines"
),
# Margins
plot.margin = margin(
10,
10,
10,
10
)
)
print(
p
)
ggplot2::ggsave(
filename = "DIVE_alpha_diversity_BOD_six_panel_time_series.png",
plot = p,
width = 11,
height = 11,
units = "in",
dpi = 600,
bg = "white"
)
