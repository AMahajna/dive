result$alpha
)
)
print(
result$correlation
)
print(
result$robustness$global_p_value
)
# Default DIVE plot
print(
plot(result)
)
# Heatmap of all diversity metrics and temporal lags
print(
plot_dive_heatmap(result)
)
# Temporal permutation null distribution
print(
plot_dive_null(result)
)
print(
list.files(
"test_output",
recursive = TRUE
)
)
